+# Receipts that also get instances storing the row max of the scores next to the LSE, which the
+# dispatch selects when fmha_fwd_args::max_ptr is set, and the pipelines that support it.
+ROW_MAX_RECEIPTS = (700,)
+ROW_MAX_PIPELINES = ("qr", "qr_hpad", "qr_async", "qr_async_trload")
+
+
+def with_row_max_variants(
+    pipelines: Iterable[FmhaFwdPipeline], receipt
+) -> List[FmhaFwdPipeline]:
+    pipelines = list(pipelines)
+    if receipt not in ROW_MAX_RECEIPTS:
+        return pipelines
+    return pipelines + [
+        replace(p, F_max="t")
+        for p in pipelines
+        if p.tag in ROW_MAX_PIPELINES
+        and p.F_lse == "t"
+        and p.F_bias == "no"
+        and p.F_dropout == "f"
+    ]
+
+
