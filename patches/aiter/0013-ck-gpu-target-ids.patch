Subject: Pass CK_CMAKE_GPU_TARGET_IDS to CK builds

diff --git a/aiter/jit/core.py b/aiter/jit/core.py
index bec3279..39fbec9 100644
--- a/aiter/jit/core.py
+++ b/aiter/jit/core.py
@@ -832,6 +832,57 @@ def validate_and_update_archs():
     return archs
 
 
+# amdgcn_target_id values from ck_tile/core/arch/arch.hpp, mirroring
+# _ck_gpu_target_string_to_id in CK's CMakeLists.txt.
+_CK_GPU_TARGET_IDS = {
+    "gfx908": "0x0908",
+    "gfx90a": "0x090A",
+    "gfx942": "0x0942",
+    "gfx950": "0x0950",
+    "gfx1030": "0x1030",
+    "gfx1031": "0x1031",
+    "gfx1032": "0x1032",
+    "gfx1033": "0x1033",
+    "gfx1034": "0x1034",
+    "gfx1035": "0x1035",
+    "gfx1036": "0x1036",
+    "gfx10-3-generic": "0x103F",
+    "gfx1100": "0x1100",
+    "gfx1101": "0x1101",
+    "gfx1102": "0x1102",
+    "gfx1103": "0x1103",
+    "gfx1150": "0x1150",
+    "gfx1151": "0x1151",
+    "gfx1152": "0x1152",
+    "gfx1153": "0x1153",
+    "gfx11-generic": "0x11FF",
+    "gfx1200": "0x1200",
+    "gfx1201": "0x1201",
+    "gfx12-generic": "0x12FF",
+    "gfx1250": "0x1250",
+    "gfx1250-strict": "0x1250",
+}
+
+
+def get_ck_gpu_target_ids():
+    """Value CK's CMake would give CK_CMAKE_GPU_TARGET_IDS for GPU_ARCHS.
+
+    Without it ck_tile resolves the target from the current compiler pass, so
+    the host pass sees HOST while the device pass sees the real arch, and the
+    two instantiate different MMA types. Unknown targets are skipped, as CK's
+    CMake does.
+    """
+    archs = validate_and_update_archs()
+    if archs == ["native"]:
+        archs = _detect_native()
+    ids = []
+    for arch in archs:
+        target_id = _CK_GPU_TARGET_IDS.get(arch.lower().split(":")[0])
+        if target_id and target_id not in ids:
+            ids.append(target_id)
+    return ",".join(ids)
+
+
 @functools.lru_cache
 def hip_flag_checker(flag_hip: str) -> bool:
     import subprocess
@@ -1398,6 +1449,9 @@ def build_module(
         # the legacy WarpGemm path for gfx1250 until CK fixes both.
         if get_gfx() == "gfx1250" or "gfx1250" in os.environ.get("GPU_ARCHS", ""):
             flags_hip += ["-DUSE_NEW_UNIFIED_FRAMEWORK=0"]
+        ck_gpu_target_ids = get_ck_gpu_target_ids()
+        if ck_gpu_target_ids:
