Subject: AITER: mha_fwd_args::max_ptr for the per-row max logit

Forward an optional max_ptr (laid out like lse_ptr) to the CK forward, whose
dispatch then picks the instances that write the exact per-row max logit next
to the LSE (needs CK patch 0012). The asm paths are skipped when it is set,
and the native split-K path rejects it.

diff --git a/csrc/cpp_itfs/mha_fwd.cu b/csrc/cpp_itfs/mha_fwd.cu
index a7a46bc..af8ea6a 100644
--- a/csrc/cpp_itfs/mha_fwd.cu
+++ b/csrc/cpp_itfs/mha_fwd.cu
@@ -240,6 +240,8 @@ float fmha_fwd_v3(mha_fwd_args a, const ck_tile::stream_config& s)
 {
     if(!a.use_asm_v3)
         return -1;
+    if(a.max_ptr != nullptr) // the asm kernels do not write the max logit
+        return -1;
 
     std::string arch_id = get_gpu_arch();
 
@@ -390,6 +392,7 @@ float fmha_fwd_ck(mha_fwd_args a, const ck_tile::stream_config& s)
                        a.drop_seed_offset,
                        a.block_scale_size_q,
                        a.block_scale_size_kv};
+    args.max_ptr = a.max_ptr;
 
     return fmha_fwd(traits, args, s);
 }
@@ -458,6 +461,8 @@ bool native_splitkv_check_eligigibility(const mha_fwd_args& a)
         return false;
     if(a.sink_size != 0)  // scalar check only; sink_ptr not checked here
         return false;
+    if(a.max_ptr != nullptr)  // the split-K kernels do not write the max logit
+        return false;
     // Only full causal (mask_type 1 or 2) or no mask (mask_type 0).
     // SWA (window_size_left != -1) falls through to ASM/CK.
     const bool causal = (a.mask_type == 1 || a.mask_type == 2);
@@ -600,6 +605,7 @@ bool mha_fwd_with_sink_supported(const mha_fwd_args& a)
     // ---- guard conditions --------------------------------------------------
     if(get_gpu_arch() != "gfx1250") return false;
     if(a.data_type != "bf16") return false;
+    if(a.max_ptr != nullptr) return false;  // the asm kernel does not write the max logit
     if(a.is_group_mode) return false;  // varlen: not supported here
     if(a.hdim_q != 64 && a.hdim_q != 128) return false;
     if(a.hdim_v != a.hdim_q) return false;
diff --git a/csrc/include/mha_fwd.h b/csrc/include/mha_fwd.h
index 09f1ef1..00f7d7b 100644
--- a/csrc/include/mha_fwd.h
+++ b/csrc/include/mha_fwd.h
@@ -249,6 +249,11 @@ struct mha_fwd_args
     //   num_splits * batch * nhead_q * seqlen_q * (kHeadDim + 1) * sizeof(float)
     int   num_splits            = 0;       // number of KV-axis splits (from mha_fwd_calculate_num_splits)
     void* splitkv_workspace_ptr = nullptr; // caller-owned device scratch buffer (see above)
+
+    // Optional fp32 per-row max logit, same layout and strides as lse_ptr (see CK
+    // fmha_fwd_args::max_ptr). Needs has_lse. Only the CK tile path writes it: the asm paths are
+    // skipped and the native split-K path rejects it.
+    void* max_ptr = nullptr;
 };
 
 #if ENABLE_CK
