Subject: mha_bwd: make v3_api_check a pure, side-effect-free dry-run probe

diff --git a/csrc/cpp_itfs/mha_bwd.cu b/csrc/cpp_itfs/mha_bwd.cu
index 6cf2453a6..629e5ee2b 100644
--- a/csrc/cpp_itfs/mha_bwd.cu
+++ b/csrc/cpp_itfs/mha_bwd.cu
@@ -247,6 +247,9 @@ float mha_bwd(mha_bwd_args a, const ck_tile::stream_config& s)
     if(asm_ret != -1)
         return asm_ret;
 
+    if(a.v3_api_check)
+        return -1;
+
     if(a.is_group_mode && (a.seqstart_q_ptr == nullptr || a.seqstart_k_ptr == nullptr))
     {
         AITER_LOG_ERROR("mha_bwd: group mode requires seqstart_q_ptr and seqstart_k_ptr");
@@ -510,6 +513,9 @@ float fmha_v3_bwd(mha_bwd_args a, const ck_tile::stream_config& s)
         return -1;
     }
 
+    if(a.v3_api_check)
+        return 1;
+
     int ts_odo;
     int ts_kv;
     int ts_dq;
@@ -572,9 +578,6 @@ float fmha_v3_bwd(mha_bwd_args a, const ck_tile::stream_config& s)
         }
     }
 
-    if(a.v3_api_check)
-        return 1;
-
     const auto odo_args  = make_fmha_bwd_odo_logical_args(a);
     auto odo_arg_storage = pack_fmha_bwd_odo_args(odo_args, compact_odo_args);
 
