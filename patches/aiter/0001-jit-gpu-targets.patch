Subject: Forward GPU targets to CK and drop cref dump

diff --git a/aiter/jit/core.py b/aiter/jit/core.py
index bd023fd0a..96bf4d9e9 100644
--- a/aiter/jit/core.py
+++ b/aiter/jit/core.py
@@ -725,6 +725,20 @@ def rename_cpp_to_cu(els, dst, hipify, recursive=False):
     return ret
 
 
+def _inject_codegen_targets(blob_gen_cmd, archs):
+    """Inject --targets so CK codegen only produces instances for *archs*."""
+    targets_arg = f"--targets {','.join(archs)}"
+
+    def inject(cmd):
+        if "generate.py" in cmd and "--targets" not in cmd:
+            return cmd.replace("generate.py ", f"generate.py {targets_arg} ", 1)
+        return cmd
+
+    if isinstance(blob_gen_cmd, list):
+        return [inject(cmd) if cmd else cmd for cmd in blob_gen_cmd]
+    return inject(blob_gen_cmd) if blob_gen_cmd else blob_gen_cmd
+
+
 def _stage_blob_sources(
     blob_gen_cmd, op_dir, src_dir, sources, hipify, seed_files=None
 ):
@@ -1177,6 +1191,7 @@ def build_module(
         flags_hip = sorted(set(flags_hip))  # remove same flags
         flags_hip = [el for el in flags_hip if hip_flag_checker(el)]
         check_and_set_ninja_worker()
+        blob_gen_cmd = _inject_codegen_targets(blob_gen_cmd, archs)
 
         blob_dir = f"{op_dir}/blob"
         staged_blob_dir = None
